# Copia este archivo a .env y reemplaza los valores. .env NUNCA se sube a Git.
#   cp .env.example .env

# --- API ---
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
# Orígenes (separados por comas) que pueden llamar a la API desde el navegador
CORS_ORIGINS=http://localhost:5173
# true solo cuando la API corre detrás del proxy del hosting (lee X-Forwarded-Proto/For)
TRUST_PROXY=false
# Minutos sin actividad tras los que expira la sesión (5 a 1440)
SESSION_IDLE_MINUTES=60
# Carpeta de la web compilada que sirve la API (TEC-04). En desarrollo no se usa (la sirve Vite);
# en producción, por omisión apps/web/dist
# WEB_DIST_DIR=apps/web/dist

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=gestion
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=gestion_dev
POSTGRES_PORT=5432

# Cadena de conexión que usará Prisma (sprint futuro). Debe coincidir con los valores de arriba.
DATABASE_URL=postgresql://gestion:cambia_esta_contrasena@localhost:5432/gestion_dev

# BD de pruebas (opcional). Si no se define, se usa DATABASE_URL con el sufijo _test (gestion_dev_test).
# Las pruebas la crean y migran solas, y se niegan a correr contra una BD que no termine en _test.
# TEST_DATABASE_URL=postgresql://gestion:cambia_esta_contrasena@localhost:5432/gestion_dev_test
