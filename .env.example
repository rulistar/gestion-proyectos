# Copia este archivo a .env y reemplaza los valores. .env NUNCA se sube a Git.
#   cp .env.example .env

# --- API ---
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=gestion
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=gestion_dev
POSTGRES_PORT=5432

# Cadena de conexión que usará Prisma (sprint futuro). Debe coincidir con los valores de arriba.
DATABASE_URL=postgresql://gestion:cambia_esta_contrasena@localhost:5432/gestion_dev
