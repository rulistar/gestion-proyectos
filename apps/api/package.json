{
  "name": "@gestion/api",
  "version": "0.0.0",
  "private": true,
  "description": "API REST (Fastify) — monolito modular",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=@gestion/source src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "postdb:migrate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "postdb:reset": "prisma generate",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "setup:admin": "tsx --env-file-if-exists=../../.env --conditions=@gestion/source src/cli/setup-admin.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@gestion/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
