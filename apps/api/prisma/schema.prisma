// Modelo de datos — ver docs/adr/ADR-0002-modelo-de-datos.md
// Convenciones: UUID v7, tablas/columnas en snake_case, timestamptz, trazabilidad (RNF-01).
// Sprint 1: User, Session, Workspace, Membership. Sprint 2: Project, Task, Invitation. El resto se agrega en su sprint.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  // partialIndexes: índices únicos que ignoran registros en la papelera (ADR-0002 §4)
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserKind {
  HUMAN
  SERVICE // usuario de servicio de una app externa (ADR-0002 §7)

  @@map("user_kind")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum MembershipRole {
  ADMIN
  MEMBER
  VIEWER

  @@map("membership_role")
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  CANCELLED
  DONE

  @@map("project_status")
}

enum ProjectPriority {
  HIGH
  MEDIUM
  LOW

  @@map("project_priority")
}

enum ProjectVisibility {
  WORKSPACE // lo ve todo el workspace
  RESTRICTED // solo los Admin y los usuarios de ProjectAccess (HU-16)

  @@map("project_visibility")
}

/// Tipos genéricos de tarea (ADR-0002 §1.1)
enum TaskType {
  TASK
  MEETING
  DELIVERABLE
  REVIEW
  RESEARCH
  EXAM

  @@map("task_type")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  PAUSED // detenida: sigue contando como pendiente (HU-24)
  DONE
  CANCELLED // no se hará: no cuenta en el avance (HU-24)

  @@map("task_status")
}

/// Persona (o app externa) con cuenta. Nunca se borra físicamente: se desactiva.
model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  /// Siempre en minúsculas y sin espacios (lo normaliza la capa de servicios)
  email         String     @unique
  name          String
  /// Hash Argon2id. Nulo en usuarios de servicio (no inician sesión con contraseña)
  passwordHash  String?    @map("password_hash")
  kind          UserKind   @default(HUMAN)
  status        UserStatus @default(ACTIVE)
  /// Administra la instalación (lo recibe el primer Admin creado con setup:admin)
  isSystemAdmin Boolean    @default(false) @map("is_system_admin")
  lastLoginAt   DateTime?  @map("last_login_at") @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdBy   User?    @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  sessions    Session[]
  memberships Membership[] @relation("MembershipUser")

  // Relaciones inversas de trazabilidad
  usersCreated        User[]       @relation("UserCreatedBy")
  usersUpdated        User[]       @relation("UserUpdatedBy")
  workspacesCreated   Workspace[]  @relation("WorkspaceCreatedBy")
  workspacesUpdated   Workspace[]  @relation("WorkspaceUpdatedBy")
  workspacesDeleted   Workspace[]  @relation("WorkspaceDeletedBy")
  membershipsCreated  Membership[] @relation("MembershipCreatedBy")
  membershipsUpdated  Membership[] @relation("MembershipUpdatedBy")
  membershipsDeleted  Membership[] @relation("MembershipDeletedBy")
  projectsCreated     Project[]    @relation("ProjectCreatedBy")
  projectsUpdated     Project[]    @relation("ProjectUpdatedBy")
  projectsDeleted     Project[]    @relation("ProjectDeletedBy")
  tasksAssigned       Task[]       @relation("TaskAssignee")
  tasksCreated        Task[]       @relation("TaskCreatedBy")
  tasksUpdated        Task[]       @relation("TaskUpdatedBy")
  tasksDeleted        Task[]       @relation("TaskDeletedBy")
  invitationsCreated  Invitation[] @relation("InvitationCreatedBy")
  invitationsUpdated  Invitation[] @relation("InvitationUpdatedBy")
  invitationsRevoked  Invitation[] @relation("InvitationRevokedBy")
  invitationsAccepted Invitation[] @relation("InvitationAcceptedBy")

  @@map("users")
}

/// Sesión activa. Se guarda el hash SHA-256 del token, nunca el token (ADR-0002 §6).
/// Dato técnico: se elimina físicamente al cerrar sesión o expirar.
model Session {
  tokenHash  String   @id @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Espacio de trabajo: frontera de seguridad de toda la información de negocio.
model Workspace {
  id   String @id @default(uuid(7)) @db.Uuid
  name String

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid
  createdBy   User?     @relation("WorkspaceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("WorkspaceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy   User?     @relation("WorkspaceDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  memberships Membership[]
  projects    Project[]
  tasks       Task[]
  invitations Invitation[]

  @@map("workspaces")
}

/// Pertenencia de un usuario a un workspace, con su rol (roles por workspace).
model Membership {
  id          String         @id @default(uuid(7)) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  role        MembershipRole
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User           @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid
  createdBy   User?     @relation("MembershipCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("MembershipUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy   User?     @relation("MembershipDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  /// Un usuario es miembro una sola vez por workspace, sin contar las membresías en la papelera
  @@unique([workspaceId, userId], map: "memberships_workspace_user_active_key", where: { deletedAt: null })
  @@index([userId])
  @@map("memberships")
}

/// Proyecto (el "curso" del prototipo, ADR-0002 §1.1).
model Project {
  id                String            @id @default(uuid(7)) @db.Uuid
  workspaceId       String            @map("workspace_id") @db.Uuid
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name              String
  /// Folio del sistema de origen (HU-31): opcional, editable, puede repetirse
  folio             String?
  description       String?
  /// Personas del proyecto (HU-31): solo el nombre; pueden no tener cuenta en el sistema
  requester         String?
  assignedTo        String?           @map("assigned_to")
  projectManager    String?           @map("project_manager")
  consultingManager String?           @map("consulting_manager")
  businessPartner   String?           @map("business_partner")
  /// Texto libre (antes "Plataforma"): Personal, Trabajo, Estudio...
  area              String?
  classification    String?
  status            ProjectStatus     @default(NOT_STARTED)
  priority          ProjectPriority   @default(MEDIUM)
  visibility        ProjectVisibility @default(WORKSPACE)
  /// Fechas sin hora: "termina el 15 de noviembre"
  startDate         DateTime?         @map("start_date") @db.Date
  endDate           DateTime?         @map("end_date") @db.Date
  /// Observaciones (en pantalla; antes "Notas")
  notes             String?

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid
  createdBy   User?     @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy   User?     @relation("ProjectDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  tasks Task[]

  @@index([workspaceId])
  @@map("projects")
}

/// Tarea de un proyecto (la "actividad" del prototipo, ADR-0002 §1.1).
/// Las fases (phaseId) llegan con HU-07.
model Task {
  id               String     @id @default(uuid(7)) @db.Uuid
  /// Redundante con el proyecto a propósito: la frontera de seguridad es el workspace (ADR-0002 §2)
  workspaceId      String     @map("workspace_id") @db.Uuid
  workspace        Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId        String     @map("project_id") @db.Uuid
  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Responsable: miembro activo del workspace, o null (sin asignar)
  assigneeId       String?    @map("assignee_id") @db.Uuid
  assignee         User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  title            String
  type             TaskType   @default(TASK)
  status           TaskStatus @default(PENDING)
  estimatedMinutes Int?       @map("estimated_minutes")
  startDate        DateTime?  @map("start_date") @db.Date
  endDate          DateTime?  @map("end_date") @db.Date
  /// Se rellena al pasar a DONE y se vacía al salir de DONE
  completedAt      DateTime?  @map("completed_at") @db.Timestamptz(3)
  /// Motivo de PAUSED o CANCELLED (obligatorio en esos estados); null en los demás
  statusReason     String?    @map("status_reason")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid
  createdBy   User?     @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("TaskUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy   User?     @relation("TaskDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([workspaceId])
  @@index([assigneeId])
  @@map("tasks")
}

/// Invitación a un workspace (HU-04). Se guarda el hash del token, nunca el token (ADR-0002 §6).
/// Sin papelera: su ciclo de vida ya es un historial (aceptada o revocada, ADR-0002 §4).
model Invitation {
  id          String         @id @default(uuid(7)) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Siempre en minúsculas y sin espacios, como User.email
  email       String
  role        MembershipRole
  tokenHash   String         @unique @map("token_hash")
  /// 48 horas después de crearla (decisión del PO)
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz(3)

  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(3)
  /// Usuario que la aceptó (HU-01)
  acceptedById String?   @map("accepted_by_id") @db.Uuid
  acceptedBy   User?     @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById  String?   @map("revoked_by_id") @db.Uuid
  revokedBy    User?     @relation("InvitationRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdBy   User?    @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("InvitationUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, email])
  @@map("invitations")
}
