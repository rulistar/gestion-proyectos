// Modelo de datos — ver docs/adr/ADR-0002-modelo-de-datos.md
// Convenciones: UUID v7, tablas/columnas en snake_case, timestamptz, trazabilidad (RNF-01).
// Sprint 1: User, Session, Workspace, Membership. Sprint 2: Project, Task, Invitation. El resto se agrega en su sprint.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  // partialIndexes: índices únicos que ignoran registros en la papelera (ADR-0002 §4)
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserKind {
  HUMAN
  SERVICE // usuario de servicio de una app externa (ADR-0002 §7)

  @@map("user_kind")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum MembershipRole {
  ADMIN
  MEMBER
  VIEWER

  @@map("membership_role")
}

/// Tipos de tarea propios de un contenedor (HU-37, ADR-0005 §4): un subconjunto de los que admite
/// su tipo. Sin filas = admite los de su tipo (HU-22).
model ProjectTaskType {
  projectId  String   @map("project_id") @db.Uuid
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskTypeId String   @map("task_type_id") @db.Uuid
  taskType   TaskType @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   User?    @relation("ProjectTaskTypeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@id([projectId, taskTypeId])
  @@index([taskTypeId])
  @@map("project_task_types")
}

/// Contenedores que una persona ve con la opción "Estos…" de su matriz (ADR-0006 §1)
model MembershipProjectAccess {
  membershipId String     @map("membership_id") @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  projectId    String     @map("project_id") @db.Uuid
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   User?    @relation("MembershipProjectAccessCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@id([membershipId, projectId])
  @@index([projectId])
  @@map("membership_project_access")
}

/// Personas cuyo trabajo puede ver un miembro, en solo lectura (HU-52): las tareas donde son
/// Responsables y, por ellas, sus contenedores
model MembershipPersonAccess {
  membershipId String     @map("membership_id") @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  personId     String     @map("person_id") @db.Uuid
  person       Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   User?    @relation("MembershipPersonAccessCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@id([membershipId, personId])
  @@index([personId])
  @@map("membership_person_access")
}

/// Persona del catálogo del espacio (HU-34, ADR-0005), con o sin cuenta. Vinculada a un usuario,
/// su nombre es el que se muestra en lugar del de la cuenta. No va a la papelera: se archiva.
model Person {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /// Usuario vinculado (opcional): a lo más una persona por usuario en cada espacio
  userId      String?   @map("user_id") @db.Uuid
  user        User?     @relation("PersonUser", fields: [userId], references: [id], onDelete: Restrict)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdBy   User?    @relation("PersonCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("PersonUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  tasksResponsible  Task[]                   @relation("TaskResponsible")
  projectsRequested Project[]                @relation("ProjectRequester")
  projectsAssigned  Project[]                @relation("ProjectAssignedTo")
  projectsManaged   Project[]                @relation("ProjectManager")
  projectsConsulted Project[]                @relation("ProjectConsultingManager")
  projectsPartnered Project[]                @relation("ProjectBusinessPartner")
  /// Miembros que pueden ver su trabajo (HU-52)
  watchers          MembershipPersonAccess[]

  @@unique([workspaceId, name], where: { archivedAt: null })
  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@map("people")
}

/// Contador de folios automáticos (HU-38): uno por espacio, prefijo (PY, MT, ACT) y periodo AAMM.
/// Registro técnico: solo lo cambia el sistema al crear un contenedor sin folio.
model FolioCounter {
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prefix      String
  /// AAMM de la fecha local del usuario: el contador vuelve a 1 cada mes
  period      String
  lastNumber  Int       @map("last_number")
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([workspaceId, prefix, period])
  @@map("folio_counters")
}

/// Cómo se mide un tipo de contenedor (ADR-0004 §2)
enum ProjectBehavior {
  WITH_END
  ONGOING
  ON_DEMAND

  @@map("project_behavior")
}

/// Tipo de contenedor del espacio (HU-21): Proyecto, Mtto correctivo, Actividades...
/// No va a la papelera: un tipo en uso se archiva (ADR-0004 §4).
model ProjectType {
  id          String          @id @default(uuid(7)) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  behavior    ProjectBehavior
  /// Orden en listas y selectores
  position    Int             @default(0)
  archivedAt  DateTime?       @map("archived_at") @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdBy   User?    @relation("ProjectTypeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("ProjectTypeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  projects         Project[]
  allowedTaskTypes ProjectTypeTaskType[]

  @@unique([workspaceId, name], where: { archivedAt: null })
  @@index([workspaceId])
  @@map("project_types")
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  CANCELLED
  DONE

  @@map("project_status")
}

/// De trabajo o personal (HU-49): en los personales sobran PM, Gte. consultoría, BP y sprint
enum ProjectScope {
  WORK
  PERSONAL

  @@map("project_scope")
}

enum ProjectPriority {
  HIGH
  MEDIUM
  LOW

  @@map("project_priority")
}

/// Tipos genéricos de tarea (ADR-0002 §1.1)
/// Tipo de tarea del espacio (HU-22): Tarea, Incidencia, Fast track... Reemplaza al enum TaskType.
/// No va a la papelera: un tipo en uso se archiva (ADR-0004 §4).
model TaskType {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /// Atención inmediata: se resalta y va primero en su columna (ADR-0004 §5)
  expedited   Boolean   @default(false)
  position    Int       @default(0)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdBy   User?    @relation("TaskTypeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("TaskTypeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  tasks        Task[]
  projectTypes ProjectTypeTaskType[]
  projects     ProjectTaskType[]

  @@unique([workspaceId, name], where: { archivedAt: null })
  @@index([workspaceId])
  @@map("task_types")
}

/// Origen de una tarea (HU-47): catálogo del espacio (Correo, Teléfono, Junta, Ticket...).
/// No va a la papelera: uno en uso se archiva (como los tipos, ADR-0004 §4).
model TaskOrigin {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  position    Int       @default(0)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdBy   User?    @relation("TaskOriginCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("TaskOriginUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  tasks Task[]

  @@unique([workspaceId, name], where: { archivedAt: null })
  @@index([workspaceId])
  @@map("task_origins")
}

/// Tipos de tarea que admite un tipo de contenedor (HU-22). Sin filas = admite todos.
model ProjectTypeTaskType {
  projectTypeId String      @map("project_type_id") @db.Uuid
  projectType   ProjectType @relation(fields: [projectTypeId], references: [id], onDelete: Cascade)
  taskTypeId    String      @map("task_type_id") @db.Uuid
  taskType      TaskType    @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   User?    @relation("ProjectTypeTaskTypeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@id([projectTypeId, taskTypeId])
  @@index([taskTypeId])
  @@map("project_type_task_types")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  PAUSED // detenida: sigue contando como pendiente (HU-24)
  DONE
  CANCELLED // no se hará: no cuenta en el avance (HU-24)

  @@map("task_status")
}

/// Persona (o app externa) con cuenta. Nunca se borra físicamente: se desactiva.
model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  /// Siempre en minúsculas y sin espacios (lo normaliza la capa de servicios)
  email         String     @unique
  name          String
  /// Hash Argon2id. Nulo en usuarios de servicio (no inician sesión con contraseña)
  passwordHash  String?    @map("password_hash")
  kind          UserKind   @default(HUMAN)
  status        UserStatus @default(ACTIVE)
  /// Administra la instalación (lo recibe el primer Admin creado con setup:admin)
  isSystemAdmin Boolean    @default(false) @map("is_system_admin")
  lastLoginAt   DateTime?  @map("last_login_at") @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdBy   User?    @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  sessions    Session[]
  memberships Membership[] @relation("MembershipUser")

  // Relaciones inversas de trazabilidad
  usersCreated            User[]                    @relation("UserCreatedBy")
  usersUpdated            User[]                    @relation("UserUpdatedBy")
  workspacesCreated       Workspace[]               @relation("WorkspaceCreatedBy")
  workspacesUpdated       Workspace[]               @relation("WorkspaceUpdatedBy")
  workspacesDeleted       Workspace[]               @relation("WorkspaceDeletedBy")
  membershipsCreated      Membership[]              @relation("MembershipCreatedBy")
  membershipsUpdated      Membership[]              @relation("MembershipUpdatedBy")
  membershipsDeleted      Membership[]              @relation("MembershipDeletedBy")
  projectsCreated         Project[]                 @relation("ProjectCreatedBy")
  projectsUpdated         Project[]                 @relation("ProjectUpdatedBy")
  projectsDeleted         Project[]                 @relation("ProjectDeletedBy")
  tasksCreated            Task[]                    @relation("TaskCreatedBy")
  tasksUpdated            Task[]                    @relation("TaskUpdatedBy")
  tasksDeleted            Task[]                    @relation("TaskDeletedBy")
  invitationsCreated      Invitation[]              @relation("InvitationCreatedBy")
  invitationsUpdated      Invitation[]              @relation("InvitationUpdatedBy")
  invitationsRevoked      Invitation[]              @relation("InvitationRevokedBy")
  invitationsAccepted     Invitation[]              @relation("InvitationAcceptedBy")
  invitationGrantsCreated InvitationGrant[]         @relation("InvitationGrantCreatedBy")
  projectTaskTypesCreated ProjectTaskType[]         @relation("ProjectTaskTypeCreatedBy")
  projectAccessCreated    MembershipProjectAccess[] @relation("MembershipProjectAccessCreatedBy")
  personAccessCreated     MembershipPersonAccess[]  @relation("MembershipPersonAccessCreatedBy")
  people                  Person[]                  @relation("PersonUser")
  peopleCreated           Person[]                  @relation("PersonCreatedBy")
  peopleUpdated           Person[]                  @relation("PersonUpdatedBy")
  projectTypesCreated     ProjectType[]             @relation("ProjectTypeCreatedBy")
  projectTypesUpdated     ProjectType[]             @relation("ProjectTypeUpdatedBy")
  taskTypesCreated        TaskType[]                @relation("TaskTypeCreatedBy")
  taskTypesUpdated        TaskType[]                @relation("TaskTypeUpdatedBy")
  allowedTaskTypesCreated ProjectTypeTaskType[]     @relation("ProjectTypeTaskTypeCreatedBy")
  taskOriginsCreated      TaskOrigin[]              @relation("TaskOriginCreatedBy")
  taskOriginsUpdated      TaskOrigin[]              @relation("TaskOriginUpdatedBy")

  @@map("users")
}

/// Sesión activa. Se guarda el hash SHA-256 del token, nunca el token (ADR-0002 §6).
/// Dato técnico: se elimina físicamente al cerrar sesión o expirar.
model Session {
  tokenHash  String   @id @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Espacio de trabajo: frontera de seguridad de toda la información de negocio.
model Workspace {
  id   String @id @default(uuid(7)) @db.Uuid
  name String

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid
  createdBy   User?     @relation("WorkspaceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("WorkspaceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy   User?     @relation("WorkspaceDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  memberships      Membership[]
  projects         Project[]
  projectTypes     ProjectType[]
  taskTypes        TaskType[]
  taskOrigins      TaskOrigin[]
  folioCounters    FolioCounter[]
  people           Person[]
  tasks            Task[]
  invitations      Invitation[]
  invitationGrants InvitationGrant[]

  @@map("workspaces")
}

/// Pertenencia de un usuario a un workspace, con su rol (roles por workspace).
model Membership {
  id            String                    @id @default(uuid(7)) @db.Uuid
  workspaceId   String                    @map("workspace_id") @db.Uuid
  userId        String                    @map("user_id") @db.Uuid
  /// Plantilla de la que partió la matriz (ADR-0006 §2); el Admin puede todo
  role          MembershipRole
  /// Matriz de permisos (ADR-0006 §1): JSON validado con memberPermissionsSchema de shared
  permissions   Json
  workspace     Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User                      @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  /// Contenedores de la opción "Estos…" de la matriz
  projectAccess MembershipProjectAccess[]
  personAccess  MembershipPersonAccess[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid
  createdBy   User?     @relation("MembershipCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("MembershipUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy   User?     @relation("MembershipDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  /// Un usuario es miembro una sola vez por workspace, sin contar las membresías en la papelera
  @@unique([workspaceId, userId], map: "memberships_workspace_user_active_key", where: { deletedAt: null })
  @@index([userId])
  @@map("memberships")
}

/// Proyecto (el "curso" del prototipo, ADR-0002 §1.1).
model Project {
  id                  String          @id @default(uuid(7)) @db.Uuid
  workspaceId         String          @map("workspace_id") @db.Uuid
  workspace           Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Tipo de contenedor (HU-21); un tipo en uso no se borra, se archiva
  typeId              String          @map("type_id") @db.Uuid
  type                ProjectType     @relation(fields: [typeId], references: [id], onDelete: Restrict)
  name                String
  /// Folio del sistema de origen (HU-31): opcional, editable, puede repetirse
  folio               String?
  description         String?
  /// Personas del proyecto (HU-36, ADR-0005 §3): del catálogo del espacio, con o sin cuenta
  requesterId         String?         @map("requester_id") @db.Uuid
  requester           Person?         @relation("ProjectRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignedToId        String?         @map("assigned_to_id") @db.Uuid
  assignedTo          Person?         @relation("ProjectAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  projectManagerId    String?         @map("project_manager_id") @db.Uuid
  projectManager      Person?         @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: Restrict)
  consultingManagerId String?         @map("consulting_manager_id") @db.Uuid
  consultingManager   Person?         @relation("ProjectConsultingManager", fields: [consultingManagerId], references: [id], onDelete: Restrict)
  businessPartnerId   String?         @map("business_partner_id") @db.Uuid
  businessPartner     Person?         @relation("ProjectBusinessPartner", fields: [businessPartnerId], references: [id], onDelete: Restrict)
  scope               ProjectScope    @default(WORK)
  /// Texto libre (antes "Plataforma"): Personal, Trabajo, Estudio...
  area                String?
  classification      String?
  status              ProjectStatus   @default(NOT_STARTED)
  priority            ProjectPriority @default(MEDIUM)
  /// Fechas sin hora: "termina el 15 de noviembre"
  startDate           DateTime?       @map("start_date") @db.Date
  endDate             DateTime?       @map("end_date") @db.Date
  /// Observaciones (en pantalla; antes "Notas")
  notes               String?
  /// Sprint en curso y lo que se hace en él (HU-33): texto libre
  sprint              String?
  sprintActivities    String?         @map("sprint_activities")
  /// Fechas reales (ADR-0004 §2.1): las pone el sistema al cambiar el estado, no se editan
  startedAt           DateTime?       @map("started_at") @db.Timestamptz(3)
  finishedAt          DateTime?       @map("finished_at") @db.Timestamptz(3)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid
  createdBy   User?     @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy   User?     @relation("ProjectDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  tasks            Task[]
  allowedTaskTypes ProjectTaskType[]
  memberAccess     MembershipProjectAccess[]

  @@index([workspaceId])
  @@index([typeId])
  @@map("projects")
}

/// Tarea de un proyecto (la "actividad" del prototipo, ADR-0002 §1.1).
/// Las fases (phaseId) llegan con HU-07.
model Task {
  id                  String      @id @default(uuid(7)) @db.Uuid
  /// Redundante con el proyecto a propósito: la frontera de seguridad es el workspace (ADR-0002 §2)
  workspaceId         String      @map("workspace_id") @db.Uuid
  workspace           Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId           String      @map("project_id") @db.Uuid
  project             Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Responsable (HU-35, corregido por el PO): una persona del catálogo del espacio, o nadie
  responsiblePersonId String?     @map("responsible_person_id") @db.Uuid
  responsiblePerson   Person?     @relation("TaskResponsible", fields: [responsiblePersonId], references: [id], onDelete: Restrict)
  title               String
  /// Tipo del catálogo (HU-22); un tipo en uso no se borra, se archiva
  typeId              String      @map("type_id") @db.Uuid
  type                TaskType    @relation(fields: [typeId], references: [id], onDelete: Restrict)
  status              TaskStatus  @default(PENDING)
  estimatedMinutes    Int?        @map("estimated_minutes")
  startDate           DateTime?   @map("start_date") @db.Date
  endDate             DateTime?   @map("end_date") @db.Date
  /// Se rellena al pasar a DONE y se vacía al salir de DONE
  completedAt         DateTime?   @map("completed_at") @db.Timestamptz(3)
  /// Inicio real (ADR-0004 §2.1): la primera vez que pasa a En curso o a Hecha; no se borra
  startedAt           DateTime?   @map("started_at") @db.Timestamptz(3)
  /// Motivo de PAUSED o CANCELLED (obligatorio en esos estados); null en los demás
  statusReason        String?     @map("status_reason")
  /// De dónde viene (HU-47): del catálogo del espacio, o ninguno; uno en uso no se borra
  originId            String?     @map("origin_id") @db.Uuid
  origin              TaskOrigin? @relation(fields: [originId], references: [id], onDelete: Restrict)
  /// Detalle del origen: "Ticket #4521 de mesa de ayuda"
  originDetail        String?     @map("origin_detail")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid
  createdBy   User?     @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("TaskUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy   User?     @relation("TaskDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([workspaceId])
  @@index([responsiblePersonId])
  @@index([typeId])
  @@index([originId])
  @@map("tasks")
}

/// Invitación a un workspace (HU-04). Se guarda el hash del token, nunca el token (ADR-0002 §6).
/// Sin papelera: su ciclo de vida ya es un historial (aceptada o revocada, ADR-0002 §4).
model Invitation {
  id          String         @id @default(uuid(7)) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Siempre en minúsculas y sin espacios, como User.email
  email       String
  role        MembershipRole
  tokenHash   String         @unique @map("token_hash")
  /// 48 horas después de crearla (decisión del PO)
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz(3)

  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(3)
  /// Usuario que la aceptó (HU-01)
  acceptedById String?   @map("accepted_by_id") @db.Uuid
  acceptedBy   User?     @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById  String?   @map("revoked_by_id") @db.Uuid
  revokedBy    User?     @relation("InvitationRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdBy   User?    @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("InvitationUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  /// Espacios a los que entra al aceptar (HU-17c, ADR-0006 §4); incluye el de workspaceId
  grants InvitationGrant[]

  @@index([workspaceId, email])
  @@map("invitations")
}

/// Un espacio de una invitación (HU-17c, ADR-0006 §4): con su plantilla, su matriz y su lista
/// "Estos…". Al aceptar se convierte en una membresía. Quien invita es Admin de cada espacio.
model InvitationGrant {
  invitationId       String         @map("invitation_id") @db.Uuid
  invitation         Invitation     @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  workspaceId        String         @map("workspace_id") @db.Uuid
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role               MembershipRole
  /// Matriz (JSON validado con memberPermissionsSchema de shared)
  permissions        Json
  /// Contenedores de "Estos…"; al aceptar se guardan los que sigan existiendo en el espacio
  selectedProjectIds String[]       @map("selected_project_ids") @db.Uuid

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   User?    @relation("InvitationGrantCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@id([invitationId, workspaceId])
  @@index([workspaceId])
  @@map("invitation_grants")
}
